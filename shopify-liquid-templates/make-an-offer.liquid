<!-- 
  Make an Offer Snippet 
  Include this in your product template (e.g., sections/main-product.liquid)
  Usage: {% render 'make-an-offer' %}
-->

{% if product.metafields.custom.enable_offer.value == true or product.metafields.custom.enable_offer == 'true' %}
<style>
  .make-an-offer-btn {
    width: 100%;
    padding: 12px;
    background-color: #000;
    color: #fff;
    border: none;
    cursor: pointer;
    font-weight: bold;
    margin-top: 10px;
    margin-bottom: 20px;
    text-transform: uppercase;
  }
  .make-an-offer-btn:hover {
    background-color: #333;
  }
  
  .offer-modal {
    display: none;
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0,0,0,0.6);
    z-index: 99999;
  }
  .offer-modal.active {
    display: block;
  }
  .offer-modal-content {
    background: #fff;
    padding: 30px;
    width: 90%;
    max-width: 500px;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    border-radius: 8px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
  }
  .offer-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
  }
  .offer-modal-header h3 {
    margin: 0;
    font-size: 20px;
  }
  .offer-modal-close {
    font-size: 28px;
    cursor: pointer;
    line-height: 1;
    color: #333;
    padding: 5px;
  }
  .offer-form-row {
    display: flex;
    gap: 15px;
    margin-bottom: 15px;
  }
  .offer-form-group {
    flex: 1;
    margin-bottom: 15px;
  }
  .offer-form-row .offer-form-group {
    margin-bottom: 0;
  }
  .offer-form-group label {
    display: block;
    margin-bottom: 5px;
    font-weight: bold;
    font-size: 14px;
  }
  .offer-form-group input {
    width: 100%;
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 4px;
    font-size: 14px;
  }
  .offer-disclaimer {
    font-size: 12px;
    color: #666;
    margin-bottom: 20px;
    background: #f9f9f9;
    padding: 10px;
    border-radius: 4px;
  }
  .offer-submit-btn {
    width: 100%;
    padding: 14px;
    background-color: #000;
    color: #fff;
    border: none;
    cursor: pointer;
    font-weight: bold;
    border-radius: 4px;
    font-size: 16px;
  }
  .offer-submit-btn:disabled {
    background-color: #666;
    cursor: not-allowed;
  }
  .offer-success-msg {
    display: none;
    color: #0f5132;
    background-color: #d1e7dd;
    padding: 10px;
    border-radius: 4px;
    font-weight: bold;
    margin-top: 15px;
    text-align: center;
  }
  .offer-error-msg {
    display: none;
    color: #842029;
    background-color: #f8d7da;
    padding: 10px;
    border-radius: 4px;
    font-weight: bold;
    margin-top: 15px;
    text-align: center;
  }
</style>

<button type="button" class="make-an-offer-btn" onclick="window.openOfferModal()">Make an Offer</button>

<div class="offer-modal" id="offerModal">
  <div class="offer-modal-content">
    <div class="offer-modal-header">
      <h3>Make an Offer</h3>
      <span class="offer-modal-close" onclick="window.closeOfferModal()">&times;</span>
    </div>
    
    <p style="margin-bottom: 15px;">Love this piece? Propose a price!</p>
    
    <div class="offer-disclaimer">
      <em>Note: Metal rates (e.g., Gold) are fixed per market value. Only Making Charges and Gemstone charges are negotiable.</em>
    </div>

    <form id="offerForm">
      <div class="offer-form-group">
        <label for="offerName">Your Name</label>
        <input type="text" id="offerName" required placeholder="John Doe">
      </div>
      
      <div class="offer-form-group">
        <label for="offerPhone">Phone Number</label>
        <input type="tel" id="offerPhone" required pattern="[0-9]{10}" minlength="10" maxlength="10" placeholder="10-digit mobile number" title="Please enter exactly 10 digits">
      </div>

      <div class="offer-form-row">
        <div class="offer-form-group">
          <label for="offerPincode">Pincode</label>
          <input type="text" id="offerPincode" required pattern="[0-9]{6}" minlength="6" maxlength="6" placeholder="6 digits">
        </div>
        <div class="offer-form-group">
          <label for="offerCity">City</label>
          <input type="text" id="offerCity" required placeholder="Your City">
        </div>
      </div>
      
      <div class="offer-form-group">
        <label for="offerAmount">Your Offer Amount (₹)</label>
        <input type="number" id="offerAmount" required min="1" placeholder="Enter amount">
      </div>
      
      <button type="submit" class="offer-submit-btn" id="offerSubmitBtn">Submit Offer</button>
      
      <div class="offer-success-msg" id="offerSuccessMsg">Your offer has been submitted! We will contact you shortly.</div>
      <div class="offer-error-msg" id="offerErrorMsg">Something went wrong. Please try again.</div>
    </form>
  </div>
</div>

<script>
  function relocateModal() {
    const modal = document.getElementById('offerModal');
    if (modal && modal.parentNode !== document.body) {
      document.body.appendChild(modal);
    }
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', relocateModal);
  } else {
    relocateModal();
  }
  window.addEventListener('load', relocateModal);

  // Setup live input validations
  function setupInputValidators() {
    const nameInput = document.getElementById('offerName');
    const phoneInput = document.getElementById('offerPhone');
    const pincodeInput = document.getElementById('offerPincode');
    const cityInput = document.getElementById('offerCity');

    if (nameInput) {
      nameInput.addEventListener('input', function() {
        this.value = this.value.replace(/[^a-zA-Z\s.]/g, '');
      });
    }
    if (phoneInput) {
      phoneInput.addEventListener('input', function() {
        this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10);
      });
    }
    if (pincodeInput) {
      pincodeInput.addEventListener('input', function() {
        this.value = this.value.replace(/[^0-9]/g, '').slice(0, 6);
      });
    }
    if (cityInput) {
      cityInput.addEventListener('input', function() {
        this.value = this.value.replace(/[^a-zA-Z\s]/g, '');
      });
    }
  }

  // Setup validators when DOM is loaded
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupInputValidators);
  } else {
    setupInputValidators();
  }

  window.openOfferModal = function() {
    relocateModal();
    document.getElementById('offerModal').classList.add('active');
  };
  
  window.closeOfferModal = function() {
    document.getElementById('offerModal').classList.remove('active');
    document.getElementById('offerSuccessMsg').style.display = 'none';
    document.getElementById('offerErrorMsg').style.display = 'none';
    document.getElementById('offerForm').reset();
  };

  // Close modal when clicking outside of it
  window.onclick = function(event) {
    const modal = document.getElementById('offerModal');
    if (event.target == modal) {
      window.closeOfferModal();
    }
  }

  document.getElementById('offerForm').addEventListener('submit', function(e) {
    e.preventDefault();
    
    const errorMsg = document.getElementById('offerErrorMsg');
    errorMsg.style.display = 'none';

    const name = document.getElementById('offerName').value.trim();
    const phone = document.getElementById('offerPhone').value.trim();
    const pincode = document.getElementById('offerPincode').value.trim();
    const city = document.getElementById('offerCity').value.trim();
    const amountVal = document.getElementById('offerAmount').value.trim();

    if (name.length < 2) {
      errorMsg.innerText = "Please enter a valid name (at least 2 letters).";
      errorMsg.style.display = 'block';
      return;
    }
    if (!phone.match(/^[0-9]{10}$/)) {
      errorMsg.innerText = "Please enter a valid 10-digit phone number.";
      errorMsg.style.display = 'block';
      return;
    }
    if (!pincode.match(/^[0-9]{6}$/)) {
      errorMsg.innerText = "Please enter a valid 6-digit pincode.";
      errorMsg.style.display = 'block';
      return;
    }
    if (city.length < 2) {
      errorMsg.innerText = "Please enter a valid city name.";
      errorMsg.style.display = 'block';
      return;
    }
    
    const amount = parseFloat(amountVal);
    if (isNaN(amount) || amount <= 0) {
      errorMsg.innerText = "Please enter a valid offer amount.";
      errorMsg.style.display = 'block';
      return;
    }

    const submitBtn = document.getElementById('offerSubmitBtn');
    submitBtn.innerText = 'Submitting...';
    submitBtn.disabled = true;
    
    document.getElementById('offerSuccessMsg').style.display = 'none';

    // IMPORTANT: Make sure this is the live URL of your VPS backend
    const APP_BACKEND_URL = 'https://api.daginawala.in/api/public/offers';

    const payload = {
      shopDomain: Shopify.shop,
      shopProductId: '{{ product.id }}',
      productTitle: '{{ product.title | escape }}',
      productUrl: window.location.href,
      customerName: name,
      customerPhone: phone,
      pincode: pincode,
      city: city,
      offerAmount: amount
    };

    fetch(APP_BACKEND_URL, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify(payload)
    })
    .then(response => response.json())
    .then(data => {
      submitBtn.innerText = 'Submit Offer';
      submitBtn.disabled = false;
      
      if(data.success) {
        document.getElementById('offerSuccessMsg').style.display = 'block';
        setTimeout(window.closeOfferModal, 3000);
      } else {
        document.getElementById('offerErrorMsg').innerText = data.error || 'Something went wrong.';
        document.getElementById('offerErrorMsg').style.display = 'block';
      }
    })
    .catch(error => {
      console.error('Offer error:', error);
      submitBtn.innerText = 'Submit Offer';
      submitBtn.disabled = false;
      document.getElementById('offerErrorMsg').innerText = 'Connection error. Please try again.';
      document.getElementById('offerErrorMsg').style.display = 'block';
    });
  });
</script>
{% endif %}
