<!-- 
  Make an Offer Snippet 
  Include this in your product template (e.g., sections/main-product.liquid)
  Usage: {% render 'make-an-offer' %}
-->

<style>
  .make-an-offer-btn {
    width: 100%;
    padding: 12px;
    background-color: #000;
    color: #fff;
    border: none;
    cursor: pointer;
    font-weight: bold;
    margin-top: 10px;
    margin-bottom: 20px;
    text-transform: uppercase;
  }
  .make-an-offer-btn:hover {
    background-color: #333;
  }
  
  .offer-modal {
    display: none;
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0,0,0,0.6);
    z-index: 99999;
  }
  .offer-modal.active {
    display: block;
  }
  .offer-modal-content {
    background: #fff;
    padding: 30px;
    width: 90%;
    max-width: 500px;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    border-radius: 8px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
  }
  .offer-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
  }
  .offer-modal-header h3 {
    margin: 0;
    font-size: 20px;
  }
  .offer-modal-close {
    font-size: 28px;
    cursor: pointer;
    line-height: 1;
    color: #333;
    padding: 5px;
  }
  .offer-form-row {
    display: flex;
    gap: 15px;
    margin-bottom: 15px;
  }
  .offer-form-group {
    flex: 1;
    margin-bottom: 15px;
  }
  .offer-form-row .offer-form-group {
    margin-bottom: 0;
  }
  .offer-form-group label {
    display: block;
    margin-bottom: 5px;
    font-weight: bold;
    font-size: 14px;
  }
  .offer-form-group input {
    width: 100%;
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 4px;
    font-size: 14px;
  }
  .offer-disclaimer {
    font-size: 12px;
    color: #666;
    margin-bottom: 20px;
    background: #f9f9f9;
    padding: 10px;
    border-radius: 4px;
  }
  .offer-submit-btn {
    width: 100%;
    padding: 14px;
    background-color: #000;
    color: #fff;
    border: none;
    cursor: pointer;
    font-weight: bold;
    border-radius: 4px;
    font-size: 16px;
  }
  .offer-submit-btn:disabled {
    background-color: #666;
    cursor: not-allowed;
  }
  .offer-success-msg {
    display: none;
    color: #0f5132;
    background-color: #d1e7dd;
    padding: 10px;
    border-radius: 4px;
    font-weight: bold;
    margin-top: 15px;
    text-align: center;
  }
  .offer-error-msg {
    display: none;
    color: #842029;
    background-color: #f8d7da;
    padding: 10px;
    border-radius: 4px;
    font-weight: bold;
    margin-top: 15px;
    text-align: center;
  }
</style>

<button type="button" class="make-an-offer-btn" onclick="openOfferModal()">Make an Offer</button>

<div class="offer-modal" id="offerModal">
  <div class="offer-modal-content">
    <div class="offer-modal-header">
      <h3>Make an Offer</h3>
      <span class="offer-modal-close" onclick="closeOfferModal()">&times;</span>
    </div>
    
    <p style="margin-bottom: 15px;">Love this piece? Propose a price!</p>
    
    <div class="offer-disclaimer">
      <em>Note: Metal rates (e.g., Gold) are fixed per market value. Only Making Charges and Gemstone charges are negotiable.</em>
    </div>

    <form id="offerForm">
      <div class="offer-form-group">
        <label for="offerName">Your Name</label>
        <input type="text" id="offerName" required placeholder="John Doe">
      </div>
      
      <div class="offer-form-group">
        <label for="offerPhone">Phone Number</label>
        <input type="tel" id="offerPhone" required pattern="[0-9]{10}" minlength="10" maxlength="10" placeholder="10-digit mobile number" title="Please enter exactly 10 digits">
      </div>

      <div class="offer-form-row">
        <div class="offer-form-group">
          <label for="offerPincode">Pincode</label>
          <input type="text" id="offerPincode" required pattern="[0-9]{6}" minlength="6" maxlength="6" placeholder="6 digits">
        </div>
        <div class="offer-form-group">
          <label for="offerCity">City</label>
          <input type="text" id="offerCity" required placeholder="Your City">
        </div>
      </div>
      
      <div class="offer-form-group">
        <label for="offerAmount">Your Offer Amount (₹)</label>
        <input type="number" id="offerAmount" required min="1" placeholder="Enter amount">
      </div>
      
      <button type="submit" class="offer-submit-btn" id="offerSubmitBtn">Submit Offer</button>
      
      <div class="offer-success-msg" id="offerSuccessMsg">Your offer has been submitted! We will contact you shortly.</div>
      <div class="offer-error-msg" id="offerErrorMsg">Something went wrong. Please try again.</div>
    </form>
  </div>
</div>

<script>
  function openOfferModal() {
    document.getElementById('offerModal').classList.add('active');
  }
  
  function closeOfferModal() {
    document.getElementById('offerModal').classList.remove('active');
    document.getElementById('offerSuccessMsg').style.display = 'none';
    document.getElementById('offerErrorMsg').style.display = 'none';
    document.getElementById('offerForm').reset();
  }

  // Close modal when clicking outside of it
  window.onclick = function(event) {
    const modal = document.getElementById('offerModal');
    if (event.target == modal) {
      closeOfferModal();
    }
  }

  document.getElementById('offerForm').addEventListener('submit', function(e) {
    e.preventDefault();
    
    // Basic validation check
    const phone = document.getElementById('offerPhone').value;
    if (!phone.match(/^[0-9]{10}$/)) {
      alert("Please enter a valid 10-digit phone number.");
      return;
    }
    
    const submitBtn = document.getElementById('offerSubmitBtn');
    submitBtn.innerText = 'Submitting...';
    submitBtn.disabled = true;
    
    document.getElementById('offerSuccessMsg').style.display = 'none';
    document.getElementById('offerErrorMsg').style.display = 'none';

    // IMPORTANT: Make sure this is the live URL of your VPS backend
    const APP_BACKEND_URL = 'https://api.daginawala.in/api/public/offers';

    const payload = {
      shopDomain: Shopify.shop,
      shopProductId: '{{ product.id }}',
      productTitle: '{{ product.title | escape }}',
      productUrl: window.location.href,
      customerName: document.getElementById('offerName').value,
      customerPhone: document.getElementById('offerPhone').value,
      pincode: document.getElementById('offerPincode').value,
      city: document.getElementById('offerCity').value,
      offerAmount: parseFloat(document.getElementById('offerAmount').value)
    };

    fetch(APP_BACKEND_URL, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify(payload)
    })
    .then(response => response.json())
    .then(data => {
      submitBtn.innerText = 'Submit Offer';
      submitBtn.disabled = false;
      
      if(data.success) {
        document.getElementById('offerSuccessMsg').style.display = 'block';
        setTimeout(closeOfferModal, 3000);
      } else {
        document.getElementById('offerErrorMsg').innerText = data.error || 'Something went wrong.';
        document.getElementById('offerErrorMsg').style.display = 'block';
      }
    })
    .catch(error => {
      console.error('Offer error:', error);
      submitBtn.innerText = 'Submit Offer';
      submitBtn.disabled = false;
      document.getElementById('offerErrorMsg').innerText = 'Connection error. Please try again.';
      document.getElementById('offerErrorMsg').style.display = 'block';
    });
  });
</script>
